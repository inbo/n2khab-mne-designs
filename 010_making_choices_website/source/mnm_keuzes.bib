@Article{legg_why_2006,
  Title                    = {Why most conservation monitoring is, but need not be, a waste of time},
  Author                   = {Legg, C. J. and Nagy, L.},
  Journal                  = {Journal of Environmental Management},
  Year                     = {2006},
  Number                   = {2},
  Pages                    = {194--199},
  Volume                   = {78},

  Abstract                 = {Ecological conservation monitoring programmes abound at various organisational and spatial levels from species to ecosystem. Many of them suffer, however, from the lack of details of goal and hypothesis formulation, survey design, data quality and statistical power at the start. As a result, most programmes are likely to fail to reach the necessary standard of being capable of rejecting a false null hypothesis with reasonable power. Results from inadequate monitoring are misleading for their information quality and are dangerous because they create the illusion that something useful has been done. We propose that conservation agencies and those funding monitoring work should require the demonstration of adequate power at the outset of any new monitoring scheme.},
  Annote                   = {Monitoring work should require the demonstration of adequate power at the outset},
  Doi                      = {10.1016/j.jenvman.2005.04.016},
  File                     = {Legg_Nagy_2006_JEnvManag.pdf:/media/floris/DATA/Private/WETPRIM/ZoteroPDFs/L/Legg_Nagy_2006_JEnvManag.pdf:application/pdf},
  Keywords                 = {bmkBeleidsgerichteMeetnetten, bmkCTX\_BeleidsgerichteMeetnetten, bmkPower, bmkTOE\_Milieu, CAT\_ModellingAndStatistics\_SamplingAndDesign, CONSERVATION MANAGEMENT, ESSENTIAL\_reading\_Floris, Floris\_ANNOTED, FlorisVanderhaeghe, Monitoring, Power analysis, Statistical analysis, THEORY},
  Shorttitle               = {Why most conservation monitoring is, but need not be, a waste of time},
  Url                      = {http://www.sciencedirect.com/science/article/pii/S0301479705001805}
}

@Article{lindenmayer_science_2010,
  Title                    = {The science and application of ecological monitoring},
  Author                   = {Lindenmayer, David B. and Likens, Gene E.},
  Journal                  = {Biological Conservation},
  Year                     = {2010},

  Month                    = jun,
  Number                   = {6},
  Pages                    = {1317--1328},
  Volume                   = {143},

  Abstract                 = {We provide a broad overview of the underlying philosophy of ecological monitoring. We argue that the major characteristics of effective monitoring programs typically include: (1) Good questions. (2) A conceptual model of an ecosystem or population. (3) Strong partnerships between scientists, policy-makers and managers. (4) Frequent use of data collected.

We classify monitoring programs into three categories – (1) Passive monitoring, which is devoid of specified questions or underlying study design and has limited rationale other than curiosity. (2) Mandated monitoring where environmental data are gathered as a stipulated requirement of government legislation or a political directive. The focus is usually to identify trends. (3) Question-driven monitoring, which is guided by a conceptual model and by a rigorous design that will typically result in a priori predictions that can be tested.

There are advantages and disadvantages of mandated monitoring programs, which are typically large-scaled, and generally smaller-scaled, question-driven monitoring programs. For example, while question-driven monitoring programs can provide insights into the ecological processes giving rise to emergent environmental patterns, spatial generalization from them is difficult because results may not extrapolate well to other regions, states or to a national level. Conversely, while mandated monitoring can be useful for producing coarse level summaries of temporal changes in a target population or resource condition they may not identify the mechanism influencing a change in an ecosystem or an entity. A key remaining challenge is to develop much improved mandated monitoring programs through more widespread adoption of the features of successful question-driven monitoring programs in efforts to enhance biodiversity conservation and environmental management.},
  Annote                   = {Mandated monitoring programs versus question-driven monitoring programs},
  Doi                      = {10.1016/j.biocon.2010.02.013},
  File                     = {Lindenmayer_Likens_2010_BiolConserv.pdf:/media/floris/DATA/Private/WETPRIM/ZoteroPDFs/L/Lindenmayer_Likens_2010_BiolConserv.pdf:application/pdf},
  ISSN                     = {0006-3207},
  Keywords                 = {Adaptive Monitoring, Biodiversity conservation, bmkCTX\_BeleidsgerichteMeetnetten, bmkFAS\_1Vraag, bmkTOE\_Milieu, CAT\_ModellingAndStatistics\_SamplingAndDesign, CAT\_Policy\_Nature, ESSENTIAL\_reading\_Floris, FlorisVanderhaeghe, Long-term ecological monitoring, Mandated monitoring, Question-driven monitoring, THEORY},
  Url                      = {http://www.sciencedirect.com/science/article/pii/S0006320710000522},
  Urldate                  = {2014-07-02}
}

@Article{lindenmayer_adaptive_2009,
  Title                    = {Adaptive monitoring: a new paradigm for long-term research and monitoring},
  Author                   = {Lindenmayer, David B. and Likens, Gene E.},
  Journal                  = {Trends in Ecology \& Evolution},
  Year                     = {2009},

  Month                    = sep,
  Note                     = {WOS:000270016800008},
  Number                   = {9},
  Pages                    = {482--486},
  Volume                   = {24},

  Abstract                 = {Long-term research and monitoring can provide important ecological insights and are crucial for the improved management of ecosystems and natural resources. However, many long-term research and monitoring programs are either ineffective or fail completely owing to poor planning and/or lack of focus. Here we propose the paradigm of adaptive monitoring, which aims to resolve many of the problems that have undermined previous attempts to establish long-term research and monitoring. This paradigm is driven by tractable questions, rigorous statistical design at the outset, a conceptual model of the ecosystem or other entity being examined and a human need to know about ecosystem change. An adaptive monitoring framework enables monitoring programs to evolve iteratively as new information emerges and research questions change.},
  Annote                   = {Resolving problems that undermined attempts for long-term research and monitoring},
  Doi                      = {10.1016/j.tree.2009.03.005},
  File                     = {Lindenmayer_Likens_2009_TrendsEcolEvol.pdf:/media/floris/DATA/Private/WETPRIM/ZoteroPDFs/L/Lindenmayer_Likens_2009_TrendsEcolEvol.pdf:application/pdf},
  ISSN                     = {0169-5347},
  Keywords                 = {abundance, acid-rain, bmkCTX\_BeleidsgerichteMeetnetten, bmkFAS\_1Vraag, bmkFAS\_2OntwerpObservatie, CAT\_ModellingAndStatistics\_SamplingAndDesign, CAT\_Policy\_Nature, Ecosystem, ESSENTIAL\_reading\_Floris, Floris\_ANNOTED, FlorisVanderhaeghe, lessons, management, science, THEORY},
  Language                 = {English},
  Shorttitle               = {Adaptive monitoring}
}

